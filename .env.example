# ============================================================
# SSCMPS API — environment template
# ============================================================
# Copy this file to .env (or .dev.vars for Wrangler) and fill in
# real values. Never commit the real .env or .dev.vars.
# ============================================================

NODE_ENV=development
PORT=3000

# JWT signing key — rotate via Supabase dashboard → Project Settings → JWT Keys
JWT_SECRET=your-jwt-signing-key

# Supabase project — URL is public, keys are not
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Resend (email notifications)
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=SSCMPS Cooperative